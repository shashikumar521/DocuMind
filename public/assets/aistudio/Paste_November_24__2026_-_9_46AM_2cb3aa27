              <button type="submit" data-component-id="button-with-icon" data-component-type="button" data-component-variant="with-icon" class="inline-flex items-center justify-center gap-gutter-xs px-gutter-md py-2.5 rounded bg-light-primary text-light-on-primary font-label text-label-lg hover:bg-light-primary-container transition-colors duration-state-change shadow-sm shrink-0">
                <span class="hidden sm:inline" data-design-text-token="label-lg">Send</span>
