  </div>

  <script>
    (function () {
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openMobile = document.getElementById('sidebar-open-mobile');
      const closeMobile = document.getElementById('sidebar-close-mobile');
      const collapseBtn = document.getElementById('sidebar-collapse-btn');

      function setMobileOpen(open) {
        sidebar.classList.toggle('-translate-x-full', !open);
        backdrop.classList.toggle('hidden', !open);
      }
      if (openMobile) openMobile.addEventListener('click', () => setMobileOpen(true));
      if (closeMobile) closeMobile.addEventListener('click', () => setMobileOpen(false));
      if (backdrop) backdrop.addEventListener('click', () => setMobileOpen(false));
      if (collapseBtn) {
        collapseBtn.addEventListener('click', () => {
          const collapsed = sidebar.classList.toggle('w-20');
          sidebar.classList.toggle('w-64', !collapsed);
          sidebar.querySelectorAll('.sidebar-label').forEach(el => el.classList.toggle('hidden', collapsed));
        });
      }

      const toggleSources = document.getElementById('toggle-sources-btn');
      const sourcesPanel = document.getElementById('sources-panel');
      const centerPane = document.getElementById('chat-center-pane');
      if (toggleSources && sourcesPanel) {
        toggleSources.addEventListener('click', () => {
          const hidden = sourcesPanel.classList.toggle('hidden');
          centerPane.classList.toggle('lg:col-span-9', hidden);
          centerPane.classList.toggle('lg:col-span-6', !hidden);
        });
      }

      const chatInput = document.getElementById('chat-input');
      const chatForm = document.getElementById('chat-form');
      const chatMessages = document.getElementById('chat-messages');
      const chatLoading = document.getElementById('chat-loading');

      document.querySelectorAll('.suggested-prompt').forEach(btn => {
        btn.addEventListener('click', () => {
          chatInput.value = btn.textContent.trim();
          chatInput.focus();
        });
      });

      if (chatForm) {
        chatForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const text = chatInput.value.trim();
          if (!text) return;
          const userBubble = document.createElement('div');
          userBubble.className = 'flex items-start justify-end gap-gutter-sm';
          userBubble.innerHTML = `<div class="bg-light-primary text-light-on-primary rounded-md px-gutter-md py-3 max-w-xl shadow-sm"><p class="font-body text-body-md"></p></div>`;
          userBubble.querySelector('p').textContent = text;
          chatMessages.insertBefore(userBubble, chatLoading);
          chatInput.value = '';
          chatLoading.classList.remove('hidden');
        });
      }

      const clearBtn = document.getElementById('clear-chat-btn');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          chatLoading.classList.add('hidden');
        });
      }

      window.copySampleAnswer = function (btn) {
        const span = btn.querySelector('span:last-child');
        if (span) {
          span.textContent = 'Copied';
          setTimeout(() => { span.textContent = 'Copy answer'; }, 1500);
        }
      };
    })();
  </script>


