                </div>
              </footer>
            </article>

            <!-- Doc 3: Extracting Text -->
            <article data-component-id="card-action" data-component-type="card" data-component-variant="action" class="doc-card bg-light-surface-container-lowest border border-light-outline-variant/60 rounded-md p-gutter-lg shadow-sm flex flex-col justify-between gap-gutter-md">
