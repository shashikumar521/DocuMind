  <script>
    (function () {
      const sidebar = document.getElementById('app-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      const openMobile = document.getElementById('sidebar-open-mobile');
      const closeMobile = document.getElementById('sidebar-close-mobile');
      const collapseBtn = document.getElementById('sidebar-collapse-btn');

      function setMobileOpen(open) {
        sidebar.classList.toggle('-translate-x-full', !open);
        backdrop.classList.toggle('hidden', !open);
      }
      if (openMobile) openMobile.addEventListener('click', () => setMobileOpen(true));
      if (closeMobile) closeMobile.addEventListener('click', () => setMobileOpen(false));
      if (backdrop) backdrop.addEventListener('click', () => setMobileOpen(false));
      if (collapseBtn) {
        collapseBtn.addEventListener('click', () => {
          const collapsed = sidebar.classList.toggle('w-20');
          sidebar.classList.toggle('w-64', !collapsed);
          sidebar.querySelectorAll('.sidebar-label').forEach(el => el.classList.toggle('hidden', collapsed));
        });
      }

      const fileInput = document.getElementById('pdf-file-input');
      const validationMsg = document.getElementById('upload-validation-msg');
      const validationText = document.getElementById('upload-validation-text');
      const toggleEmpty = document.getElementById('toggle-empty-state');
      const listSection = document.getElementById('documents-list-section');
      const emptySection = document.getElementById('empty-state-section');

      if (toggleEmpty) {
        toggleEmpty.addEventListener('click', () => {
          const showingEmpty = !emptySection.classList.contains('hidden');
          emptySection.classList.toggle('hidden', showingEmpty);
          listSection.classList.toggle('hidden', !showingEmpty);
          toggleEmpty.textContent = showingEmpty ? 'Preview Empty State' : 'Show Sample Documents';
        });
      }

      if (fileInput) {
        fileInput.addEventListener('change', (e) => {
          const files = Array.from(e.target.files || []);
          validationMsg.classList.add('hidden');
          for (const f of files) {
            if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
              validationText.textContent = `"${f.name}" is an unsupported file type. Only PDF files are accepted.`;
              validationMsg.classList.remove('hidden');
              return;
            }
            if (f.size > 25 * 1024 * 1024) {
              validationText.textContent = `"${f.name}" exceeds the 25 MB size limit.`;
              validationMsg.classList.remove('hidden');
              return;
            }
          }
        });
      }

      window.removeDocCard = function (btn) {
        const card = btn.closest('.doc-card');
        if (card) card.remove();
        const remaining = document.querySelectorAll('.doc-card').length;
        document.getElementById('doc-count').textContent = String(remaining);
        if (remaining === 0) {
          listSection.classList.add('hidden');
          emptySection.classList.remove('hidden');
        }
      };
    })();
  </script>


</body></html>