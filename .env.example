# GEMINI_API_KEY: Required server-side key for Gemini AI generation and embeddings.
# Never prefix this with VITE_ or expose it to frontend code.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional chat model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL=gemini-4-hydrogen

# DATABASE_URL: Required in production (Vercel) for managed PostgreSQL with pgvector.
# Stores document metadata, text chunks, vector embeddings, and conversation history.
DATABASE_URL=

# BLOB_READ_WRITE_TOKEN: Required in production (Vercel) for durable PDF object storage via Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# BLOB_ACCESS: Optional Vercel Blob access mode ('public' or 'private', defaults to 'public').
BLOB_ACCESS=public

# APP_URL: Application base URL (injected automatically in hosted environments).
APP_URL=
